{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Second Name",
  "version": "0.1.0",
  "identifier": "io.github.joshtseppich.secondname",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/build-web.mjs",
    "beforeBuildCommand": "node scripts/build-web.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Second Name",
        "width": 480,
        "height": 880,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "A poetry submission desk",
    "longDescription": "Second Name keeps your poems, venues, reading windows and fee waivers in one place, prepares submission packets for you to approve, and offers a copilot that runs on your own AI key.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5NUU1NDc1NTNDMDI3NzMKUldSeko4QlRkVlJlR1Uyc1dDeHZBTlF0ZzJ6emQ5T1RXNjBZK0krU21aN2hDUy9YbjJ5ek42SXoK",
      "endpoints": [
        "https://github.com/JoshTSeppich/second-name/releases/latest/download/latest.json"
      ]
    }
  }
}
